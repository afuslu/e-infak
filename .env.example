# Root .env.example

# Environment
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://einfak:einfak123@localhost:5432/einfak

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# API & Web
NEXT_PUBLIC_API_URL=http://localhost:8020
NEXT_PUBLIC_API_VERSION=v1
PUBLIC_WEB_URL=http://localhost:3000
PAYMENT_CALLBACK_BASE_URL=http://localhost:8020

# Security & Tenancy (REQUIRED in production)
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
CREDENTIALS_ENCRYPTION_KEY=
TENANT_PROXY_SECRET=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Platform Domains & Certificates (Production SaaS)
PLATFORM_BASE_DOMAIN=e-infak.org
PLATFORM_CNAME_TARGET=sites.e-infak.org
PLATFORM_PUBLIC_IP=
PLATFORM_ALLOWED_IPS=
CERT_SERVICE_HOST=

# Email (SendGrid / SMTP)
SENDGRID_API_KEY=
FROM_EMAIL=noreply@e-infak.org
FROM_NAME=E-İnfak

# Payments
PAYMENTS_LIVE_ENABLED=false
ZIRAATPAY_API_URL=https://test.ziraatpay.com.tr/ziraatpay/api/v2
ZIRAATPAY_HPP_URL=https://test.ziraatpay.com.tr/payment
ZIRAATPAY_MERCHANT=
ZIRAATPAY_MERCHANT_USER=
ZIRAATPAY_MERCHANT_PASSWORD=
ZIRAATPAY_SECRET_KEY=
ZIRAATPAY_TENANT_CREDENTIALS=

# SMS (Netgsm) - Optional
NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_SENDER=EINFAK

# File Storage (Local / S3 / R2)
MEDIA_ROOT=media
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=e-infak-files
S3_REGION=auto

# Monitoring & Alerts - Optional
SENTRY_DSN=
ALERT_WEBHOOK_URL=
