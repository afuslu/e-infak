# Canlı varsayılanı: https://e-infak.org/api/v1 (kurum, giriş yapan kullanıcıdan çözülür).
# EXPO_PUBLIC_API_HOST=e-infak.org

# Telefonda yerel backend'e bağlanmak için tam adres (Mac'in ağ IP'si):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1

# Tarayıcıda (npm run web) yerel backend: Metro içindeki vekil kullanılır.
# EXPO_PUBLIC_DEV_PROXY=1
# DEV_API_TARGET=http://127.0.0.1:8000
