{
  "expo": {
    "name": "e-İnfak",
    "slug": "e-infak",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "einfak",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#059669"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.einfak.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Kumbara QR kodlarını okutmak için kamera erişimi gereklidir.",
        "NSFaceIDUsageDescription": "Hesabınıza hızlı ve güvenli giriş yapmak için Face ID kullanılır."
      }
    },
    "android": {
      "package": "org.einfak.app",
      "versionCode": 29,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#059669"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "./plugins/withFixAndroidPackage",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#059669"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Kumbara QR kodlarını okutmak için kamera izni gereklidir."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Hesabınıza hızlı ve güvenli giriş için Face ID kullanılır."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#059669"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.org.einfak.app",
          "widgets": [
            {
              "name": "EinfakInflow",
              "displayName": "Bugün gelen para",
              "description": "Kurumunuza bugün gelen bağışlar: toplam, kanal dağılımı ve bekleyen havaleler.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular"
                ]
              }
            },
            {
              "name": "EinfakQuickActions",
              "displayName": "Hızlı işlemler",
              "description": "Tek dokunuşla makbuz kes, kumbara QR tara, havaleler ve arama.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ]
              }
            },
            {
              "name": "EinfakTransfers",
              "displayName": "Bekleyen havaleler",
              "description": "Eşleşmeyi bekleyen son havaleler ve toplam tutar.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            },
            {
              "name": "EinfakTasksGoals",
              "displayName": "Kampanya ve görevler",
              "description": "Öne çıkan kampanya hedef ilerlemesi ve açık görevleriniz.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "EinfakInflow",
              "label": "e-İnfak · Bugün gelen para",
              "description": "Bugün gelen bağışlar, kanal dağılımı ve bekleyen havaleler.",
              "previewImage": "./assets/widgets/preview-inflow.png",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "EinfakCompact",
              "label": "e-İnfak · Mini sayaç",
              "description": "Bugünkü toplam bağış ve bekleyen havale rozeti.",
              "previewImage": "./assets/widgets/preview-compact.png",
              "minWidth": "110dp",
              "minHeight": "90dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "EinfakQuickActions",
              "label": "e-İnfak · Hızlı işlemler",
              "description": "Makbuz kes, kumbara QR tara, havaleler ve hızlı arama kısayolları.",
              "previewImage": "./assets/widgets/preview-quick.png",
              "minWidth": "250dp",
              "minHeight": "60dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 0
            },
            {
              "name": "EinfakTransfers",
              "label": "e-İnfak · Bekleyen havaleler",
              "description": "Eşleşmeyi bekleyen havalelerin özeti ve son gelen satırlar.",
              "previewImage": "./assets/widgets/preview-transfers.png",
              "minWidth": "220dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "EinfakTasksGoals",
              "label": "e-İnfak · Kampanya ve görevler",
              "description": "Aktif kampanya hedef çubuğu ve açık görevleriniz.",
              "previewImage": "./assets/widgets/preview-tasks.png",
              "minWidth": "220dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "a8f04a9f-2106-403c-9e08-ca43b6b9c560"
      }
    },
    "owner": "afuslu",
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
