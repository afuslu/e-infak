[Unit]
Description=E-İnfak üç aylık geri yükleme testi
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Environment=HOME=/root
ExecStart=/usr/local/sbin/e-infak-restore-test
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
TimeoutStartSec=4h
