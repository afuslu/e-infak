[Unit]
Description=E-Medrese saatlik veritabanı yedeği (Google Drive)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Environment=HOME=/root
Environment=PROJE=e-medrese
ExecStart=/usr/local/sbin/e-medrese-saatlik
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
TimeoutStartSec=20min
