# E-İnfak sertifika servisi (compose: certs).
# Trafik sunmaz: kurum alt alan adları ve doğrulanmış özel alan adları için Let's Encrypt
# sertifikasını ilk TLS el sıkışmasında (on-demand) alır ve /data altına yazar. Host nginx
# bu dosyaları her el sıkışmada okur (deploy/docker/nginx-otomatik-ssl.sh), böylece yeni
# alan adları sudo ve nginx reload gerektirmez.
# El sıkışmayı yalnızca worker yapar (TLS portu dışarı açık değil); izin backend'den sorulur.
{
	admin off
	persist_config off
	http_port 8080
	https_port 8443
	auto_https disable_redirects
	storage file_system /data
	on_demand_tls {
		ask http://backend:8000/api/v1/internal/tls-allowed
	}
}

https:// {
	tls {
		on_demand
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			# Doğrulama yalnızca HTTP-01: Let's Encrypt :80'e gelir, host nginx
			# /.well-known/acme-challenge/ isteklerini 127.0.0.1:8480'e (bu servis) iletir.
			disable_tlsalpn_challenge
		}
	}
	respond 404
}

# Bilinmeyen doğrulama isteklerine işaretli yanıt: nginx-otomatik-ssl.sh yolu bununla sınar.
http:// {
	respond "einfak-certs" 404
}
